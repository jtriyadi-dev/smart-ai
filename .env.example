# ==========================================
# SMART-AI.ID PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================
# NOTICE: Do not commit actual secrets or credentials to source control.
# Copy this file to .env.local for development, or inject via Cloud Secret Manager for Production.

# 1. CORE APPLICATION & DOMAIN
# ------------------------------------------
# The primary canonical URL for the production web application.
APP_URL="https://www.smart-ai.id"
# The backend API gateway base URL.
API_URL="https://www.smart-ai.id/api"
# Target environment runtime mode (development | staging | production).
NODE_ENV="production"
# Server logging level (DEBUG | INFO | WARN | ERROR).
LOG_LEVEL="INFO"

# 2. AI INTEGRATION & LLM PROVIDER
# ------------------------------------------
# Required: Google Gemini API key for server-side AI solutions & blueprints.
GEMINI_API_KEY=""
# AI Provider abstraction ("gemini" | "vertex-ai" | "openai-compatible")
AI_PROVIDER="gemini"
# Default generative model alias
AI_MODEL="gemini-2.5-flash"
# Fallback model alias for high-volume batch tasks
AI_FALLBACK_MODEL="gemini-2.5-flash"

# 3. DATABASE & PERSISTENCE
# ------------------------------------------
# PostgreSQL / Cloud SQL database connection string with pooling parameters.
DATABASE_URL="postgresql://smartai_user:password@127.0.0.1:5432/smartai_production?sslmode=require&pool_size=20"
# Maximum connection pool capacity
DATABASE_POOL_MAX=20
# Connection timeout in milliseconds
DATABASE_TIMEOUT_MS=5000

# 4. AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------
# Secret key used for signing session tokens and JWT authentication (min 32 chars).
AUTH_SECRET=""
# Secret key used for cryptographic session cookies and HMAC hashing.
SESSION_SECRET=""
# Session expiration duration (e.g. 7d, 24h).
SESSION_EXPIRATION="7d"

# 5. CORS & NETWORK ACCESS
# ------------------------------------------
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing.
CORS_ALLOWED_ORIGINS="https://smart-ai.id,https://www.smart-ai.id"

# 6. EXTERNAL SERVICES & INTEGRATIONS (OPTIONAL)
# ------------------------------------------
# Cloud Storage Bucket for client project documents, invoices, and exported PDFs.
CLOUD_STORAGE_BUCKET=""
CLOUD_STORAGE_REGION="asia-southeast2"

# SMTP Transactional Email Gateway
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="support@smart-ai.id"

# Official WhatsApp Business API
WHATSAPP_API_ENDPOINT=""
WHATSAPP_API_KEY=""
WHATSAPP_BUSINESS_PHONE="6281234567890"

# Indonesian Payment Gateway (Midtrans / Xendit)
PAYMENT_GATEWAY_MODE="sandbox" # "sandbox" or "production"
PAYMENT_GATEWAY_SERVER_KEY=""
PAYMENT_GATEWAY_CLIENT_KEY=""

